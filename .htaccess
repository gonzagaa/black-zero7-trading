# LP Black Zero7 Trading. Mesmo padrão do ../lp-black-friday/.htaccess.
#
# Material interno responde 404 (e não 403: o 403 confirma que o arquivo existe).
# RedirectMatch é do mod_alias. "Require all denied" não foi usado de propósito: exige AuthConfig e, se ela não
# estiver liberada, a pasta inteira devolve 500. Sem RewriteEngine, para não anular regras de pastas acima.
# NÃO bloqueie aqui nada que a página carrega (css/, js/, assets/, obrigado/).
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)/(_referencia|docs|relatorios|shots|scripts|node_modules)(/|$)
  RedirectMatch 404 (?i)\.md$
  RedirectMatch 404 (?i)/package(-lock)?\.json$
  RedirectMatch 404 (?i)\.log$
  # dotfiles e dotpastas em qualquer nível (.gitignore, .git, .htaccess...), menos .well-known
  RedirectMatch 404 (?i)/\.(?!well-known(/|$))
</IfModule>

# ==============================
# CACHE (cache busting por ?v=, scripts/versao.mjs)
# ==============================
# O HTML aponta para as versões novas: sempre revalida. Tudo o que ele carrega (CSS, JS, imagens, fontes) sai com
# ?v=<versão>, então pode ficar um ano em cache: a versão nova é outra URL.
# "Header set" (e não "always") nos estáticos: um 404 passageiro não pode ficar um ano em cache.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always set X-LiteSpeed-Cache-Control "no-cache"
    Header always unset Expires
  </FilesMatch>

  <FilesMatch "\.(css|m?js|png|jpe?g|webp|avif|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Cache de página do LiteSpeed desligado nesta pasta: o HTML sai sempre do disco
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>
